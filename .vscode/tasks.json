
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Сборка и запуск программы",
            "command": "/bin/zsh",
            "args": [
                "-c",
                "/usr/bin/clang++ -std=c++17 -g main.cpp Pipe.cpp Station.cpp -o program && ./program"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Сборка всех файлов проекта"
        }
    ]
}
